{
  "name": "svela-arrows-3d-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5178",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5178",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "android:assets": "node scripts/android-assets.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "node scripts/android-build.mjs debug",
    "android:bundle": "node scripts/android-build.mjs bundle"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.180.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
